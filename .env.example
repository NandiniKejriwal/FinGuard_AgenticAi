# FinGuard Environment Configuration Example

# Google Gemini API Key (Optional: system runs with deterministic cognitive fallback if omitted)
GEMINI_API_KEY=your_gemini_api_key_here

# Set true to execute each specialist through native Google ADK Runner or CrewAI Crew.
# Requires a valid GEMINI_API_KEY and internet access.
FINGUARD_NATIVE_FRAMEWORKS=true
FINGUARD_MODEL=gemini-2.0-flash

# Plaid Sandbox Credentials (Simulated database used by default)
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_secret
PLAID_ENV=sandbox

# Langfuse Observability Credentials (Optional: logs to local traces/ directory if omitted)
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com

# Server Configuration
PORT=8501
HOST=0.0.0.0
